# Variables de Entorno para La Matera del Gringo
# Copiar este archivo como .env.local para desarrollo o configurar en las variables de entorno de Vercel

# 1. Conexión con Supabase (Opcional - Si no se configuran, la aplicación opera en modo offline / localStorage)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# 2. Credenciales Administrativas Personalizadas (Opcional)
VITE_ADMIN_EMAIL=admin@lamateradelgringo.com
VITE_ADMIN_PASSWORD=admin
